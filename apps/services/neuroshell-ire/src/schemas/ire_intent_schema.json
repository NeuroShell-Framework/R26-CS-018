{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "IRE_IntentSchema",
  "type": "object",
  "required": ["intent", "target", "confidence"],
  "additionalProperties": false,
  "properties": {
    "intent": {
      "type": "string",
      "enum": [
        "NETWORK_SCAN", "VULNERABILITY_AUDIT", "DIRECTORY_BRUTEFORCE",
        "SERVICE_ENUMERATION", "EXPLOITATION", "PASSWORD_ATTACK",
        "PASSIVE_RECON", "AMBIGUOUS", "REJECTED"
      ]
    },
    "target": {
      "type": "object",
      "required": ["type", "value"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["IP", "SUBNET", "DOMAIN", "URL", "HOSTNAME", "UNKNOWN"]
        },
        "value": { "type": "string" }
      }
    },
    "ports": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
    },
    "modifiers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "cve_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^CVE-\\d{4}-\\d{4,7}$" }
    },
    "tool_hint": { "type": ["string", "null"] },
    "schedule":  { "type": ["string", "null"] },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "rejection_reason": { "type": ["string", "null"] }
  }
}
