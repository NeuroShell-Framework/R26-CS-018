# ── Supabase Auth ─────────────────────────────────────────────────────
# Project URL (Project Settings > API) and public anon key.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── NeuroShell API services ───────────────────────────────────────────
# Component 01 (IRE) — the chat UI talks to this one; it chains to C2 internally.
VITE_C1_URL=http://127.0.0.1:8001
VITE_C2_URL=http://127.0.0.1:8002

# Optional: C1 API key. C1 runs in dev-mode auth-bypass if unset.
VITE_C1_API_KEY=