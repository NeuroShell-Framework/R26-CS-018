# Environment: Development

# Application
APP_NAME=neuroshell-service
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# CORS
CORS_ORIGINS=*
CORS_METHODS=GET,POST,PUT,DELETE,PATCH
CORS_HEADERS=*

# JWT (Development only - do not use in production)
JWT_SECRET_KEY=dev-secret-key-do-not-use-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT={time:YYYY-MM-DD HH:mm:ss} | {level: <8} | {name}:{function} - {message}

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100