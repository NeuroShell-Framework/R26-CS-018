# Environment: Staging

# Application
APP_NAME=neuroshell-service
APP_VERSION=0.1.0
ENVIRONMENT=staging
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000

# CORS
CORS_ORIGINS=https://staging.neuroshell.ai
CORS_METHODS=GET,POST,PUT,DELETE,PATCH
CORS_HEADERS=Authorization,Content-Type

# JWT
JWT_SECRET_KEY=staging-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging
LOG_LEVEL=INFO
LOG_FORMAT={time:YYYY-MM-DD HH:mm:ss} | {level: <8} | {name}:{function} - {message}

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60